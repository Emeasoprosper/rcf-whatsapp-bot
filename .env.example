BACKEND_URL=https://rcf-library-backend.onrender.com
SITE_URL=https://rcf-mouau-library.vercel.app
GEMINI_API_KEY=
GEMINI_MODEL=
BOT_MODE=tag_and_requests
DAILY_AI_LIMIT=150
SENDER_COOLDOWN_SECONDS=600
GROUP_COOLDOWN_SECONDS=30
# One or more group ids, comma separated. Only needed without BOT_API_KEY;
# with it, groups are managed on the admin app's WhatsApp Bot page.
ALLOWED_GROUP_JID=
# Server only: the library database URL, so the WhatsApp login survives
# restarts. Leave empty on your PC (login stays in auth_info_baileys).
DATABASE_URL=
# Same secret as BOT_API_KEY on the Render backend (admin posts to WhatsApp)
BOT_API_KEY=
# "Upload to the library" advert every N hours, 0 = off
PROMO_EVERY_HOURS=48
WELCOME_NEW_MEMBERS=true
# Join lively discussions without being tagged (max once per cooldown per group)
CHIME_IN=true
CHIME_IN_COOLDOWN_MINUTES=60
# Bot only starts posts between these Lagos hours
ACTIVE_FROM_HOUR=7
ACTIVE_TO_HOUR=21
